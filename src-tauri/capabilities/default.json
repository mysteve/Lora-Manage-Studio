{
  "identifier": "default",
  "description": "Main desktop window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-confirm",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/mysteve/Lora-Manage-Studio" },
        { "url": "https://github.com/mysteve/Lora-Manage-Studio/releases" },
        { "url": "https://civitai.com/*" },
        { "url": "https://civitai.red/*" },
        { "url": "https://auth.civitai.com/login/oauth/device" },
        { "url": "https://auth.civitai.com/login/oauth/device[?]*" }
      ]
    },
    "opener:allow-reveal-item-in-dir",
    "clipboard-manager:allow-write-text"
  ]
}
