{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoRA Studio",
  "version": "0.1.0",
  "identifier": "studio.lora.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LoRA Studio",
        "width": 1600,
        "height": 1000,
        "minWidth": 1000,
        "minHeight": 680,
        "decorations": false,
        "dragDropEnabled": false,
        "shadow": true,
        "backgroundColor": "#101113"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: data: blob:; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; object-src 'none'; frame-src 'none'",
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/covers/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "LoRA Studio",
    "shortDescription": "ComfyUI 本地 LoRA 模型管理工具",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../docs/INSTALL.md": "INSTALL.md",
      "../src/features/about/licenses/": "licenses/",
      "../src/components/react-bits/LICENSE.md": "licenses/React-Bits.md",
      "../src/features/prompts/data/tagcomplete-LICENSE.txt": "licenses/Tagcomplete.txt",
      "../src/features/prompts/data/prompt-all-in-one-LICENSE.txt": "licenses/Prompt-All-in-One.txt"
    },
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": { "type": "offlineInstaller" }
    }
  }
}
